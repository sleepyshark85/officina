#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bookshop'
require 'dotenv'

# This machine's settings, from the .env beside exe/ if there is one; a variable set in the shell wins.
Dotenv.load(File.expand_path('../.env', __dir__))

# The terminal is the staff member's conversation: the OpenTelemetry SDK's own complaints, such as each failed export
# while the dashboard is not running, would land in the middle of it.
OpenTelemetry.logger = Logger.new(File::NULL)

# --demo compacts and clears early enough to see in a short session.
demo_flag = '--demo'
abort "Usage: bookshop [#{demo_flag}]" unless (ARGV - [demo_flag]).empty?
begin
  application = Bookshop.build(input: $stdin, output: $stdout, demo: ARGV.include?(demo_flag))
rescue Bookshop::SettingError, Bookshop::ExportServerError => e
  abort e.message
end
begin
  application.run
ensure
  application.close
end
