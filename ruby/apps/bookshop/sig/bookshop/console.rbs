module Bookshop
  class Console
    class Command < Data
      attr_reader name: String
      attr_reader argument: String?
      attr_reader help: String
      attr_reader handler: Symbol

      def self.new: (String name, String? argument, String help, Symbol handler) -> Command

      def usage: () -> String
    end

    COMMANDS: Hash[String, Command]
    COMMAND_START: String
    HELP_HINT: String
    USAGE_WIDTH: Integer
    HELP: String

    @demo: bool
    @audit: AuditView
    @memory: StaffMemory
    @telemetry: Telemetry
    @approvals: Approvals
    @budgets: Budgets
    @terminal: Terminal
    @sessions: SessionCommands
    @interrupts: Interrupts

    def initialize: (agent: Sleepyshark::Officina::Agent, approvals: Approvals, input: IO, output: IO,
                     clock: ^() -> Time, store: SessionStore, budgets: Budgets, audit: AuditView,
                     memory: StaffMemory, telemetry: Telemetry, summarizer: Summarizer?, demo: bool) -> void
    def run: () -> void

    private

    def ask_staff_member: () -> String?
    def converse: (Session session) -> Session
    def command: (String line, Session session) -> Session
    def help: (String _argument, Session session) -> Session
    def start_new: (String _argument, Session session) -> Session
    def list_sessions: (String _argument, Session session) -> Session
    def resume: (String id, Session session) -> Session
    def cost: (String _argument, Session session) -> Session
    def memory: (String _argument, Session session) -> Session
    def quit: (String _argument, Session _session) -> bot
    def audit: (String id, Session session) -> Session
    def answered: (Session session) { () -> void } -> Session
    def reply: (Session session, String message) -> void
  end
end
