module Bookshop
  class Console
    class Command < Data
      attr_reader name: String
      attr_reader argument: String?
      attr_reader help: String

      def self.new: (String name, String? argument, String help) -> Command

      def usage: () -> String
      def ===: (untyped other) -> bool
    end

    HELP_COMMAND: Command
    NEW: Command
    SESSIONS: Command
    RESUME: Command
    COST: Command
    AUDIT: Command
    MEMORY: Command
    QUIT: Command
    COMMANDS: Array[Command]
    COMMAND_START: String
    HELP_HINT: String
    USAGE_WIDTH: Integer
    HELP: String

    @demo: bool
    @audit: AuditView
    @memory: StaffMemory
    @telemetry: Telemetry
    @approvals: Approvals
    @budgets: Budgets
    @terminal: Terminal
    @sessions: SessionCommands
    @interrupts: Interrupts

    def initialize: (agent: Sleepyshark::Officina::Agent, approvals: Approvals, input: IO, output: IO,
                     clock: ^() -> Time, store: SessionStore, budgets: Budgets, audit: AuditView,
                     memory: StaffMemory, telemetry: Telemetry, summarizer: Summarizer?, demo: bool) -> void
    def run: () -> void

    private

    def ask_staff_member: () -> String?
    def converse: (Session session) -> Session
    def reply: (Session session, String message) -> void
  end
end
