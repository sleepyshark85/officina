module Sleepyshark
  module Officina
    class MemoryCommand
      @files: MemoryFiles
      @input: Hash[String, untyped]
      @path: String
      @new_path: String
      @at: String
      @within: Hash[String, String]

      def initialize: (MemoryFiles files, Hash[String, untyped] input, Array[String] paths, Hash[String, String] within) -> void

      def run: (Symbol command) -> (String | ToolFailure)

      private

      def view: () -> (String | ToolFailure)

      def create: () -> (String | ToolFailure)

      def str_replace: () -> (String | ToolFailure)

      def replace_once: (String text, String old) -> (String | ToolFailure)

      def replace: (String text, Integer start, String old) -> (String | ToolFailure)

      def insert: () -> (String | ToolFailure)

      def insert_line: (Array[String] lines, Integer line, String text) -> (String | ToolFailure)

      def delete: () -> (String | ToolFailure)

      def rename: () -> (String | ToolFailure)

      def rename_problem: (String to) -> String?

      def write: (String text) -> ToolFailure?

      def missing: () -> String

      def no_path: () -> String

      def file_in_the_way: (String file) -> String

      def root_kept: (String done) -> String

      def cannot_create: (String why) -> ToolFailure

      def failure: (String message) -> ToolFailure
    end
  end
end
